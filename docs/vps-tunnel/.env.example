# Copy to .env on the VPS. The .env file is ignored by Git.
OPENSSH_IMAGE=lscr.io/linuxserver/openssh-server:10.3_p1-r0-ls233
PUID=1000
PGID=1000
TZ=America/Los_Angeles
VPS_SSH_PORT=25522
VPS_MINECRAFT_PORT=25565
SSH_TUNNEL_USER=minecraft-tunnel

# Keep the outer single quotes. Replace the key body with craftopia_tunnel.pub.
SSH_TUNNEL_AUTHORIZED_KEY='restrict,port-forwarding,permitlisten="0.0.0.0:25565",command="/bin/false" ssh-ed25519 replace-with-the-public-key craftopia-reverse-tunnel'
