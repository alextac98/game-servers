# Safe local validation defaults only. Copy to .env for local use; never commit it.
MINECRAFT_IMAGE=itzg/minecraft-server:2026.8.2-java25
BACKUP_IMAGE=itzg/mc-backup:2026.8.2
MINECRAFT_PORT=25565
MINECRAFT_TYPE=FORGE
MINECRAFT_VERSION=26.2
MEMORY=4G
RCON_PASSWORD=replace-with-a-strong-local-password

# Browser administration. Use a different password from RCON_PASSWORD.
RCON_WEB_USERNAME=admin
RCON_WEB_PASSWORD=replace-with-a-separate-strong-ui-password
# Localhost by default; optionally set the Docker host's LAN/VPN IP.
RCON_WEB_BIND_ADDRESS=127.0.0.1
RCON_WEB_WEBSOCKET_URL=ws://localhost:4326/ws
RCON_WEB_WEBSOCKET_URL_SSL=wss://console.mc.alextac.com/ws

# Reverse SSH tunnel to the public VPS. These two values are placeholders only.
SSH_TUNNEL_HOST=mc.alextac.com
SSH_TUNNEL_PORT=25522
SSH_TUNNEL_USER=minecraft-tunnel
SSH_TUNNEL_BIND_ADDRESS=0.0.0.0
SSH_TUNNEL_REMOTE_PORT=25565
SSH_TUNNEL_PRIVATE_KEY=replace-with-the-complete-private-key
SSH_TUNNEL_KNOWN_HOSTS=[mc.alextac.com]:25522 ssh-ed25519 replace-with-the-verified-host-key

# Optional Coolify overrides
TZ=America/Los_Angeles
BACKUP_INTERVAL=24h
PAUSE_IF_NO_PLAYERS=true
PRUNE_BACKUPS_COUNT=7
PRUNE_BACKUPS_DAYS=30
